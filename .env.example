# SaaSKit Configuration
# Copy to .env and adjust values for your environment.

# ─── Server ────────────────────────────────────────────
SAASKIT_ENV=development
SAASKIT_PORT=8080
SAASKIT_BASE_URL=http://localhost:8080

# ─── Database ──────────────────────────────────────────
SAASKIT_DATABASE_URL=postgres://saaskit:saaskit@localhost:5432/saaskit?sslmode=disable
SAASKIT_DATABASE_MAX_CONNS=25
SAASKIT_DATABASE_MIN_CONNS=5

# ─── JWT / Signing Keys ───────────────────────────────
# Algorithm: RS256, ES256, or EdDSA
SAASKIT_JWT_ALGORITHM=RS256
SAASKIT_JWT_KEY_PATH=./keys
SAASKIT_JWT_ISSUER=http://localhost:8080
SAASKIT_JWT_ACCESS_TTL=15m
SAASKIT_JWT_REFRESH_TTL=168h

# Server secret used for HMAC-based token hashing.
# MUST be set in production. Auto-generated in development if missing.
SAASKIT_SERVER_SECRET=change-me-in-production-use-64-random-bytes

# ─── Encryption (envelope encryption for stored secrets) ─
SAASKIT_ENCRYPTION_MASTER_KEY=change-me-32-byte-hex-encoded-key

# ─── Password Hashing (Argon2id) ──────────────────────
SAASKIT_ARGON2_MEMORY=65536
SAASKIT_ARGON2_ITERATIONS=3
SAASKIT_ARGON2_PARALLELISM=4
SAASKIT_ARGON2_SALT_LENGTH=16
SAASKIT_ARGON2_KEY_LENGTH=32

# ─── OAuth Providers ──────────────────────────────────
SAASKIT_OAUTH_GOOGLE_CLIENT_ID=
SAASKIT_OAUTH_GOOGLE_CLIENT_SECRET=
SAASKIT_OAUTH_GITHUB_CLIENT_ID=
SAASKIT_OAUTH_GITHUB_CLIENT_SECRET=

# ─── Logging ──────────────────────────────────────────
SAASKIT_LOG_LEVEL=info
SAASKIT_LOG_FORMAT=json

# ─── Rate Limiting ────────────────────────────────────
SAASKIT_RATE_LIMIT_AUTH_RPM=10
SAASKIT_RATE_LIMIT_API_RPM=60
